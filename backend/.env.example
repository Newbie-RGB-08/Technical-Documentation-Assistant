# PTDRA 后端环境变量样例（复制为 backend/.env 后按需修改）
# 说明：所有 ${VAR:default} 占位符在 config/models.yaml 中解析，本文件为 .env 的注释样例。

# ---- MySQL（元数据）----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
# 请改成本机 MySQL 的 root 密码
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=rag_meta

# ---- Ollama（本地 LLM）----
OLLAMA_HOST=http://localhost:11434

# ---- 云端模型 Key（可选；配置任一即启用对应云端 Provider）----
# DEEPSEEK_API_KEY=sk-xxx
# QWEN_API_KEY=sk-xxx
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-xxx

# ---- Provider 健康检测与本地模型发现（V1.5.x 启动自检，按需调整）----
# 关闭后整体退回旧的“逐次 is_available”行为
PROVIDER_PROBE_ENABLED=true
# 单 Provider 探测超时（秒）
PROVIDER_PROBE_TIMEOUT_SECONDS=2.5
# 健康快照 / 本地模型发现清单的 TTL（秒）
PROVIDER_HEALTH_TTL_SECONDS=30
# 发现清单按名称过滤非对话模型的关键词（逗号分隔）
LOCAL_MODEL_EXCLUDE_KEYWORDS=embed,bge,nomic,minilm,mxbai,rerank,guard,whisper,gte,sentence

# ---- LLM 调用 ----
# 单次 Provider 调用超时（秒），超时即降级链上下一家
LLM_TIMEOUT_SECONDS=60

# ---- 知识库上传 ----
UPLOAD_ENABLED=true
# 默认 backend/data/uploads；相对路径按后端工作目录解析
# UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=100
UPLOAD_MAX_FILES_PER_BATCH=20
UPLOAD_MAX_PAGES=500
UPLOAD_MAX_IMAGES=300
UPLOAD_MAX_CHUNKS=5000
UPLOAD_MAX_MARKDOWN_CHARS=5000000
UPLOAD_CONCURRENCY=1
UPLOAD_PARSE_TIMEOUT_SECONDS=600
UPLOAD_PDF_TEXT_MIN_CHARS=80
UPLOAD_IMAGE_OCR=false
UPLOAD_ENGINE_HEALTH_TTL_SECONDS=30

# ---- 解析引擎（自托管，不走云 API）----
RAPIDOCR_MODEL_DIR=./data/models/rapidocr
MINERU_API_URI=http://127.0.0.1:30001
MINERU_TIMEOUT_SECONDS=600
PADDLEX_URI=http://127.0.0.1:8080
PADDLEX_TIMEOUT_SECONDS=300

# ---- HuggingFace 镜像（默认已内置，无需改）----
# HF_ENDPOINT=https://hf-mirror.com

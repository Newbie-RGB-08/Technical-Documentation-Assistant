# P7：MinerU / PaddleX 容器环境变量样例
# 复制为 deploy/parsers/.env 后按需修改。
# 注意：不要在此放置任何云 API Key；端口均只绑定本机 127.0.0.1。

# ---- 端口 ----
# MinerU 服务端口（对应 backend .env 的 MINERU_API_URI=http://127.0.0.1:<MINERU_PORT>）
MINERU_PORT=30001
# PaddleX 服务端口（对应 backend .env 的 PADDLEX_URI=http://127.0.0.1:<PADDLEX_PORT>）
PADDLEX_PORT=8080

# ---- 镜像 tag/digest（固定版本，可换为 digest 提升可复现性） ----
# MINERU_IMAGE_DIGEST=mineruai/mineru_3-1_1-services-api:3.2.1
# PADDLEX_IMAGE_DIGEST=paddlepaddle/paddlex:3.0.0-slim

# ---- 模型缓存卷名（推荐固定，避免重建容器后重新下载模型） ----
MINERU_MODEL_VOLUME=ptda-mineru-models
PADDLEX_MODEL_VOLUME=ptda-paddlex-models